+namespace presetrelayhook
+{
+    // Runs one request. A handler that throws, or a reply that cannot become a property list, gives an error dictionary, never null and
+    // never the previous reply. Returns a +1 retained dictionary, or nullptr only when even the error cannot be built.
+    inline CFPropertyListRef answer (presetrelay::Handler& handler, const std::string& request)
+    {
+        try
+        {
+            std::string reply;
+
+            try { reply = handler.handleRequest (request); }
+            catch (...) { reply = presetrelay::errorReply ("failed", "internal error"); }
+
+            if (auto* plist = presetrelay::jsonToCF (reply))
+                return plist;
+
+            return presetrelay::jsonToCF (presetrelay::errorReply ("failed", "the reply could not be converted"));
+        }
+        catch (...)
+        {
+            return nullptr;
+        }
+    }
+
+    // The last reply, kept for the host's next read of the property. Every access holds the mutex; requests run outside it.
+    // The destructor releases the reply, so it goes away with the wrapper.
+    class ReplySlot
+    {
+    public:
+        ReplySlot() = default;
+        ReplySlot (const ReplySlot&) = delete;
+        ReplySlot& operator= (const ReplySlot&) = delete;
+        ~ReplySlot() { replace (nullptr); }
+
+        // Takes the caller's +1 reference.
+        void replace (CFPropertyListRef newValue)
+        {
+            CFPropertyListRef old;
+
+            {
+                std::lock_guard<std::mutex> guard (lock);
+                old = value;
+                value = newValue;
+            }
+
+            if (old != nullptr)
+                CFRelease (old);
+        }
+
+        // Takes the caller's +1 reference only when it returns true.
+        bool storeIfEmpty (CFPropertyListRef newValue)
+        {
+            std::lock_guard<std::mutex> guard (lock);
+
+            if (value != nullptr)
+                return false;
+
+            value = newValue;
+            return true;
+        }
+
+        // A +1 reference to the stored reply, or nullptr when there is none.
+        CFPropertyListRef copy()
+        {
+            std::lock_guard<std::mutex> guard (lock);
+            return value != nullptr ? (CFPropertyListRef) CFRetain (value) : nullptr;
+        }
+
+    private:
+        std::mutex lock;
+        CFPropertyListRef value = nullptr;
+    };
+}
