+   #if JUCE_PRESET_BRIDGE
+    // Shows the loaded catalog sound's name through the ordinary current preset (spec E.5): AUBase answers
+    // kAudioUnitProperty_PresentPreset and writes the ClassInfo "name" from its own current preset. Does nothing when the
+    // plugin reports no name or the base class already holds it; the factory preset list and restore are untouched.
+    // NewCustomPresetSet takes its own reference to the name and releases the old one. Never throws.
+    void refreshPresetRelayName()
+    {
+        try
+        {
+            auto* handler = dynamic_cast<presetrelay::Handler*> (juceFilter.get());
+            if (handler == nullptr)
+                return;
+
+            const auto name = handler->currentSoundName();
+            if (name.empty())
+                return;
+
+            CFUniquePtr<CFStringRef> wanted (CFStringCreateWithBytes (kCFAllocatorDefault, (const UInt8*) name.data(),
+                                                                     (CFIndex) name.size(), kCFStringEncodingUTF8, false));
+            if (wanted == nullptr)
+                return;
+
+            static std::mutex presetNameLock;   // keeps two refreshes from swapping the name at once
+            std::lock_guard<std::mutex> guard (presetNameLock);
+
+            AUPreset held { -1, nullptr };
+
+            if (MusicDeviceBase::GetProperty (kAudioUnitProperty_PresentPreset, kAudioUnitScope_Global, 0, &held) == noErr
+                && held.presetName != nullptr)
+            {
+                const bool same = CFStringCompare (held.presetName, wanted.get(), 0) == kCFCompareEqualTo;
+                CFRelease (held.presetName);   // GetProperty handed us a reference
+
+                if (same)
+                    return;
+            }
+
+            AUPreset fresh { -1, wanted.get() };
+            NewCustomPresetSet (fresh);
+        }
+        catch (...) {}
+    }
+   #endif
